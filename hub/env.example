# Copy to .env files under a private dir; never commit real values.
LEDGER_MODE=memory            # memory | drunix
PII_SALT=change-me
# --- drunix mode only ---
DRUNIX_CHANNEL=mychannel
DRUNIX_CC_NAME=remit
DRUNIX_ORDERER=localhost:7050
DRUNIX_ORDERER_CA=/path/to/orderer/tls/ca.crt
DRUNIX_ORG_ENV_DIR=/path/to/private/org-env   # holds org1.env and org2.env
# DRUNIX_ENDORSE_PEERS="localhost:7051|/path/org1-tlsca.pem,localhost:9051|/path/org2-tlsca.pem"
